# Daraja sandbox credentials for `pnpm test:sandbox`. Copy to .env (gitignored) and fill in.
# The suite only calls the sandbox when MPESA_SANDBOX=1, which `pnpm test:sandbox` sets.

# From your sandbox app on https://developer.safaricom.co.ke/MyApps
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Lipa na M-Pesa Online passkey and shortcode (the portal's sandbox test values)
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Initiator (API operator). The name and the test data are prefilled in the portal's
# simulator once you select your app (open any API page and use the Daraja Simulator).
MPESA_INITIATOR_NAME=
# Either the SecurityCredential generated on the portal's Test Credentials page...
MPESA_SECURITY_CREDENTIAL=
# ...or the initiator password plus the sandbox certificate (keep it outside the repo).
# Only this pair tests the SDK's own encryption.
MPESA_INITIATOR_PASSWORD=
MPESA_CERTIFICATE_PATH=

# Organisation shortcode used for C2B, B2C, Business To Pochi, B2B, Pull Transactions,
# Transaction Status, Account Balance and Reversal
MPESA_B2C_SHORTCODE=
MPESA_TEST_MSISDN=254708374149

# A URL you control that shows received POST bodies (callbacks are pasted into
# __tests__/fixtures/sandbox/callbacks/raw/ by hand). Must not contain words like
# "mpesa" or "safaricom", which Daraja rejects for C2B registration.
MPESA_CALLBACK_URL=

# Optional: a sandbox receipt to use for Transaction Status and Reversal
MPESA_TEST_TRANSACTION_ID=
