{
  "name": "mpesa-api",
  "version": "3.0.2",
  "description": "An NPM Module built with NodeJs to help you with M-Pesa Daraja API calls.",
  "keywords": [
    "mobile money",
    "money",
    "mpesa",
    "node",
    "nodejs"
  ],
  "homepage": "https://github.com/newtonmunene99/mpesa-api/",
  "bugs": {
    "url": "https://github.com/newtonmunene99/mpesa-api/issues"
  },
  "license": "MIT",
  "author": "Newton Munene <newtonmunene99@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newtonmunene99/mpesa-api.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "test:dist": "node scripts/smoke-dist.mjs",
    "lint:pkg": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.3",
    "publint": "^0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.6.0"
}
